# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose builds DATABASE_URL from these) ---
POSTGRES_USER=vsr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vsr_ai
# For running the backend outside Docker, set it directly (SQLite default if unset):
# DATABASE_URL=postgresql+psycopg://vsr:change-me@localhost:5432/vsr_ai

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- Agents ---
# none = deterministic agents (no API key needed; all published results use this)
# openai | anthropic = LLM routing, tool-calling and grounded answer synthesis
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Embeddings: hashing (offline, deterministic) | openai ---
EMBEDDING_PROVIDER=hashing

# --- Reliability ---
RATE_LIMIT_PER_MINUTE=300
CHAT_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
REQUEST_TIMEOUT_SECONDS=45
# Only true behind a reverse proxy that overwrites X-Forwarded-For (the bundled nginx does).
TRUST_PROXY_HEADERS=false
